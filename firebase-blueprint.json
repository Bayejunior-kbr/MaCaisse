{
  "entities": {
    "Shop": {
      "title": "Shop",
      "description": "A business shop using the application",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "premium"] },
        "logo_url": { "type": "string" },
        "theme": { "type": "string" },
        "language": { "type": "string" },
        "currency": { "type": "string" },
        "receipt_footer": { "type": "string" },
        "show_tax": { "type": "boolean" },
        "sms_enabled": { "type": "boolean" },
        "whatsapp_enabled": { "type": "boolean" },
        "notification_template": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "blocked", "expired", "grace_period"] },
        "is_signaled": { "type": "boolean" },
        "subscription_expires_at": { "type": "string", "format": "date-time" },
        "has_ai_features": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "User": {
      "title": "User",
      "description": "A user account",
      "type": "object",
      "properties": {
        "shop_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "owner", "employee"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "An inventory item",
      "type": "object",
      "properties": {
        "shop_id": { "type": "string" },
        "category_id": { "type": "string" },
        "supplier_id": { "type": "string" },
        "name": { "type": "string" },
        "barcode": { "type": "string" },
        "image_url": { "type": "string" },
        "purchase_price": { "type": "number" },
        "sale_price": { "type": "number" },
        "quantity": { "type": "integer" },
        "min_quantity": { "type": "integer" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["shop_id", "name", "purchase_price", "sale_price"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A sales transaction",
      "type": "object",
      "properties": {
        "shop_id": { "type": "string" },
        "user_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "total_amount": { "type": "number" },
        "total_profit": { "type": "number" },
        "tax_amount": { "type": "number" },
        "discount_amount": { "type": "number" },
        "payment_method": { "type": "string" },
        "payment_status": { "type": "string" },
        "amount_paid": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["shop_id", "user_id", "total_amount"]
    },
    "Customer": {
      "title": "Customer",
      "description": "A customer record",
      "type": "object",
      "properties": {
        "shop_id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "total_debt": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["shop_id", "name"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "A product supplier",
      "type": "object",
      "properties": {
        "shop_id": { "type": "string" },
        "name": { "type": "string" },
        "contact_name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["shop_id", "name"]
    }
  },
  "firestore": {
    "/shops/{shopId}": {
      "schema": "Shop",
      "description": "Shop details"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": "Product",
      "description": "Products belonging to a shop"
    },
    "/shops/{shopId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Sales belonging to a shop"
    },
    "/shops/{shopId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customers belonging to a shop"
    },
    "/shops/{shopId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Suppliers belonging to a shop"
    }
  }
}
